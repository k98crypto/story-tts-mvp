  <div id="toast" class="toast" role="status" aria-live="polite"></div>
  <script>
    const sourceText = document.getElementById('sourceText');
    const segmentList = document.getElementById('segmentList');
    const roleList = document.getElementById('roleList');
    const voicesNote = document.getElementById('voiceNote');
    const toast = document.getElementById('toast');
    const modelStatus = document.getElementById('modelStatus');
    const modelStatusDot = document.getElementById('modelStatusDot');
    const ttsApiBase = window.location.origin;
    const authGate = document.getElementById('authGate');
    const authMessage = document.getElementById('authMessage');
    const signupDialog = document.getElementById('signupDialog');
    const signupMessage = document.getElementById('signupMessage');
    const recoveryDialog = document.getElementById('recoveryDialog');
    const recoveryMessage = document.getElementById('recoveryMessage');
    const newPasswordDialog = document.getElementById('newPasswordDialog');
    const newPasswordMessage = document.getElementById('newPasswordMessage');
    let authConfig = null;
    let authToken = '';
    let authRefreshToken = '';
    let currentUser = null;
    let lastSignupEmail = '';
    const emotionOptions = [
      ['neutral', '平静'], ['sad', '悲伤'], ['angry', '愤怒'], ['hesitant', '迟疑'], ['whisper', '耳语'], ['joy', '喜悦']
    ];
    const modelVoices = [
      ['Dylan', '青年男声'],
      ['Uncle_Fu', '成熟男声'],
      ['Vivian', '明亮女声'],
      ['Serena', '温柔女声'],
      ['Eric', '活泼男声']
    ];
    let segments = [];
    let roleVoices = {};
    let modelReady = false;
    let queue = [];
    let queueIndex = 0;
    let runId = 0;
    let requestController = null;
    let currentAudio = null;
    let currentAudioUrl = null;
    let toastTimer;
    const deepSeekFormatPrompt = `后续剧情请按以下格式输出，便于我进行角色配音：
角色台词单独一行，格式为“角色名：台词”。不要把动作或语气说明写进引号里的台词。
动作、神态、场景和说话方式单独放在括号中，例如：（沈砚猛地推开门，压低声音。）
请保留角色名字，不要把角色台词和旁白混在同一段。除非剧情需要，不要添加格式说明。`;

    function showToast(message) {
      toast.textContent = message;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), 2600);
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function setAuthMessage(message, isError = false) {
      authMessage.textContent = message;
      authMessage.dataset.error = String(isError);
    }

    function setSignupMessage(message, isError = false) {
      signupMessage.textContent = message;
      signupMessage.dataset.error = String(isError);
    }

    function setRecoveryMessage(message, isError = false) {
      recoveryMessage.textContent = message;
      recoveryMessage.dataset.error = String(isError);
    }

    function setNewPasswordMessage(message, isError = false) {
      newPasswordMessage.textContent = message;
      newPasswordMessage.dataset.error = String(isError);
    }

    function togglePassword(inputId, buttonId) {
      const input = document.getElementById(inputId);
      const button = document.getElementById(buttonId);
      const visible = input.type === 'password';
      input.type = visible ? 'text' : 'password';
      button.setAttribute('aria-label', visible ? '隐藏密码' : '显示密码');
      button.title = visible ? '隐藏密码' : '显示密码';
    }

    function showAuthGate(message = '') {
      authToken = '';
      currentUser = null;
      sessionStorage.removeItem('spiritwave.accessToken');
      sessionStorage.removeItem('spiritwave.refreshToken');
      document.getElementById('appShell').hidden = true;
      document.getElementById('player').hidden = true;
      document.getElementById('accountControls').hidden = true;
      authGate.hidden = false;
      if (message) setAuthMessage(message, true);
    }

    function enterApp(user) {
      currentUser = user;
      document.getElementById('accountEmail').textContent = user.email || '';
      document.getElementById('accountRole').hidden = user.isAdmin !== true;
      document.getElementById('adminLink').hidden = user.isAdmin !== true;
      document.getElementById('accountControls').hidden = false;
      document.getElementById('appShell').hidden = false;
      document.getElementById('player').hidden = false;
      authGate.hidden = true;
      renderRoles();
    }

    async function supabaseRequest(path, body, accessToken = '', redirectTo = '') {
      const headers = {'Content-Type':'application/json', 'apikey':authConfig.publishableKey};
      if (accessToken) headers.Authorization = `Bearer ${accessToken}`;
      const url = new URL(`${authConfig.url}/auth/v1/${path}`);
      if (redirectTo) url.searchParams.set('redirect_to', redirectTo);
      const response = await fetch(url, {
        method:'POST', headers, body:JSON.stringify(body), cache:'no-store'
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.msg || result.message || result.error_description || '账号服务请求失败');
      return result;
    }

    async function verifySession(token) {
      const response = await fetch(`${ttsApiBase}/session`, {
        headers:{Authorization:`Bearer ${token}`}, cache:'no-store'
      });
      if (!response.ok) return null;
      return response.json();
    }

    async function restoreEmailCallback() {
      const params = new URLSearchParams(location.hash.slice(1));
      const token = params.get('access_token');
      const callbackError = params.get('error_description') || new URLSearchParams(location.search).get('error_description');
      if (!token) {
        if (callbackError) setAuthMessage(callbackError, true);
        return false;
      }
      const refreshToken = params.get('refresh_token') || '';
      const type = params.get('type') || '';
      history.replaceState(null, '', `${location.pathname}${location.search}`);
      const user = await verifySession(token);
      if (!user) {
        setAuthMessage('邮箱验证已完成，但登录会话无效，请使用邮箱和密码登录。', true);
        return false;
      }
      authToken = token;
      authRefreshToken = refreshToken;
      sessionStorage.setItem('spiritwave.accessToken', authToken);
      if (authRefreshToken) sessionStorage.setItem('spiritwave.refreshToken', authRefreshToken);
      if (type === 'recovery') {
        document.getElementById('newPasswordForm').reset();
        setNewPasswordMessage('');
        newPasswordDialog.showModal();
        document.getElementById('newPassword').focus();
        return true;
      }
      enterApp(user);
      return true;
    }

    async function restoreSession() {
      const savedToken = sessionStorage.getItem('spiritwave.accessToken');
      const savedRefresh = sessionStorage.getItem('spiritwave.refreshToken');
      if (savedToken) {
        const user = await verifySession(savedToken);
        if (user) {
          authToken = savedToken;
          authRefreshToken = savedRefresh || '';
          enterApp(user);
          return true;
        }
      }
      if (savedRefresh && authConfig) {
        try {
          const session = await supabaseRequest('token?grant_type=refresh_token', {refresh_token:savedRefresh});
          authToken = session.access_token;
          authRefreshToken = session.refresh_token || savedRefresh;
          const user = await verifySession(authToken);
          if (user) {
            sessionStorage.setItem('spiritwave.accessToken', authToken);
            sessionStorage.setItem('spiritwave.refreshToken', authRefreshToken);
            enterApp(user);
            return true;
          }
        } catch {}
      }
      try {
        const response = await fetch(`${ttsApiBase}/session`, {cache:'no-store', credentials:'same-origin'});
        const session = await response.json();
        if (response.ok && session.accessToken) {
          authToken = session.accessToken;
          authRefreshToken = '';
          sessionStorage.setItem('spiritwave.accessToken', authToken);
          sessionStorage.removeItem('spiritwave.refreshToken');
          enterApp(session);
          return true;
        }
      } catch {}
      showAuthGate();
      return false;
    }

    async function authenticate(mode) {
      if (!authConfig?.ready) return;
      const isSignup = mode === 'signup';
      const form = document.getElementById(isSignup ? 'signupForm' : 'authForm');
      if (!form.reportValidity()) return;
      const email = document.getElementById(isSignup ? 'signupEmail' : 'authEmail').value.trim();
      const passwordInput = document.getElementById(isSignup ? 'signupPassword' : 'authPassword');
      const password = passwordInput.value;
      if (isSignup && password !== document.getElementById('signupPasswordConfirm').value) {
        setSignupMessage('两次输入的密码不一致。', true);
        return;
      }
      const button = document.getElementById(isSignup ? 'signupButton' : 'loginButton');
      button.disabled = true;
      if (isSignup) setSignupMessage('正在注册…');
      else setAuthMessage('正在登录…');
      try {
        if (isSignup) {
          await supabaseRequest('signup', {email, password}, '', location.origin);
          lastSignupEmail = email;
          document.getElementById('resendSignupButton').hidden = false;
          setSignupMessage('注册申请已提交。未收到邮件时，请检查垃圾邮件或重新发送。');
          return;
        }
        const session = await supabaseRequest('token?grant_type=password', {email, password});
        authToken = session.access_token;
        authRefreshToken = session.refresh_token || '';
        const user = await verifySession(authToken);
        if (!user) throw new Error('账号尚未完成邮箱验证，或登录会话无效');
        let rememberError = '';
        try {
          const rememberResponse = await fetch(`${ttsApiBase}/auth/remember`, {
            method:'POST',
            headers:{'Content-Type':'application/json', Authorization:`Bearer ${authToken}`},
            body:JSON.stringify({remember:document.getElementById('rememberForSevenDays').checked, refreshToken:authRefreshToken}),
            cache:'no-store'
          });
          const rememberResult = await rememberResponse.json().catch(() => ({}));
          if (!rememberResponse.ok) throw new Error(rememberResult.error || '记住登录设置失败');
          if (rememberResult.remembered) {
            authToken = rememberResult.accessToken || authToken;
            authRefreshToken = '';
          }
        } catch (error) {
          rememberError = error.message || '7 天免登录设置失败，本次登录仍有效。';
          authRefreshToken = session.refresh_token || '';
        }
        sessionStorage.setItem('spiritwave.accessToken', authToken);
        if (authRefreshToken) sessionStorage.setItem('spiritwave.refreshToken', authRefreshToken);
        else sessionStorage.removeItem('spiritwave.refreshToken');
        enterApp(user);
        setAuthMessage('');
        if (rememberError) showToast(rememberError);
      } catch (error) {
        const message = error.message || (isSignup ? '注册失败，请稍后重试。' : '登录失败，请稍后重试。');
        if (isSignup) setSignupMessage(message, true);
        else setAuthMessage(message.includes('Invalid login credentials')
          ? '邮箱或密码不匹配。若之前用此邮箱注册过，重复注册不会更改旧密码，请使用“忘记密码”重设。'
          : message, true);
      } finally {
        button.disabled = false;
      }
    }

    async function requestPasswordReset() {
      const emailInput = document.getElementById('recoveryEmail');
      if (!emailInput.reportValidity()) return;
      const button = document.getElementById('recoveryButton');
      button.disabled = true;
      setRecoveryMessage('正在发送…');
      try {
        await supabaseRequest('recover', {email:emailInput.value.trim()}, '', location.origin);
        setRecoveryMessage('如果该邮箱已注册，重置链接很快会发送到邮箱。');
      } catch (error) {
        setRecoveryMessage(error.message || '发送失败，请稍后重试。', true);
      } finally {
        button.disabled = false;
      }
    }

    async function saveNewPassword() {
      const form = document.getElementById('newPasswordForm');
      if (!form.reportValidity()) return;
      const password = document.getElementById('newPassword').value;
      if (password !== document.getElementById('newPasswordConfirm').value) {
        setNewPasswordMessage('两次输入的密码不一致。', true);
        return;
      }
      const button = document.getElementById('saveNewPasswordButton');
      button.disabled = true;
      setNewPasswordMessage('正在更新密码…');
      try {
        const response = await fetch(`${authConfig.url}/auth/v1/user`, {
          method:'PUT',
          headers:{'Content-Type':'application/json', apikey:authConfig.publishableKey, Authorization:`Bearer ${authToken}`},
          body:JSON.stringify({password}),
          cache:'no-store'
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.msg || result.message || '密码更新失败，请重新申请重置链接。');
        const user = await verifySession(authToken);
        if (!user) throw new Error('密码已更新，请使用新密码重新登录。');
        enterApp(user);
        newPasswordDialog.close();
        showToast('密码已更新');
      } catch (error) {
        setNewPasswordMessage(error.message || '密码更新失败，请稍后重试。', true);
      } finally {
        button.disabled = false;
      }
    }

    async function initializeAuth() {
      try {
        const response = await fetch(`${ttsApiBase}/config`, {cache:'no-store'});
        authConfig = await response.json();
        authConfig = {
          ready:response.ok && authConfig.authReady === true,
          url:authConfig.supabaseUrl,
          publishableKey:authConfig.publishableKey,
        };
        if (!authConfig.ready) {
          setAuthMessage('账号服务尚未配置，注册与合成暂不可用。');
          return;
        }
        document.getElementById('loginButton').disabled = false;
        document.getElementById('openSignupButton').disabled = false;
        document.getElementById('signupButton').disabled = false;
        document.getElementById('recoveryButton').disabled = false;
        setAuthMessage('');
        if (await restoreEmailCallback()) return;
        await restoreSession();
      } catch {
        const localPreview = ['localhost', '127.0.0.1'].includes(location.hostname);
        setAuthMessage(localPreview ? '本地预览不提供注册和登录，请使用正式网址。' : '无法连接账号服务配置，请稍后重试。', true);
      }
    }

    async function logout() {
      try {
        if (authToken && authConfig?.ready) {
          try {
            await fetch(`${ttsApiBase}/auth/remember`, {
              method:'POST',
              headers:{'Content-Type':'application/json'},
              body:JSON.stringify({remember:false}),
              cache:'no-store'
            });
          } catch {}
          await fetch(`${authConfig.url}/auth/v1/logout`, {
            method:'POST',
            headers:{'apikey':authConfig.publishableKey, Authorization:`Bearer ${authToken}`},
          });
        }
      } finally {
        stopPlayback();
        showAuthGate('已退出登录');
      }
    }

    async function refreshModelStatus() {
      try {
        const response = await fetch(`${ttsApiBase}/health`, {cache:'no-store'});
        const health = await response.json();
        modelReady = response.ok && health.ready === true;
        modelStatus.textContent = modelReady ? 'Qwen3-TTS 已就绪' : 'Qwen3-TTS 正在启动';
        modelStatusDot.dataset.ready = String(modelReady);
        voicesNote.textContent = modelReady
          ? '角色音色由服务器 Qwen3-TTS 提供；情绪会映射为模型语气指令。'
          : '等待服务器模型加载完成';
      } catch {
        modelReady = false;
        modelStatus.textContent = '服务器模型不可用';
        modelStatusDot.dataset.ready = 'false';
        voicesNote.textContent = '无法连接服务器语音服务';
      }
      renderRoles();
    }

    function selectedModelVoice(speaker) {
      if (!roleVoices[speaker]) {
        const gender = segments.find(segment => segment.speaker === speaker && segment.genderHint)?.genderHint;
        roleVoices[speaker] = gender === 'female' ? 'Serena' : 'Dylan';
      }
      return roleVoices[speaker];
    }

    function parseLine(line) {
      const text = line.trim().replace(/^[-*]\s+/, '');
      if (!text || /^#{1,6}\s/.test(text)) return null;
      let match = text.match(/^([^：:「『“"()（）]{1,24})[：:][\s　]*[「『“"](.+?)[」』”"]?\s*$/);
      if (match) return { type: 'dialogue', speaker: match[1].trim(), text: match[2].trim(), emotion: 'neutral', skip: false };
      match = text.match(/^([^：:「『“"()（）]{1,24})[：:][\s　]*(.+)$/);
      if (match) return { type: 'dialogue', speaker: match[1].trim(), text: match[2].trim().replace(/[」』”"]$/, ''), emotion: 'neutral', skip: false };
      if (/^[（(].+[）)]$/.test(text)) return { type: 'action', speaker: '旁白', text: text.slice(1, -1).trim(), emotion: 'neutral', skip: true };
      return { type: 'narration', speaker: '旁白', text: text.replace(/^>\s*/, ''), emotion: 'neutral', skip: false };
    }

    function parseScript() {
      stopPlayback();
      const lines = sourceText.value.split(/\r?\n+/).map(parseLine).filter(Boolean);
      const parsed = [];
      lines.forEach((line, index) => {
        if (line.type !== 'action') {
          parsed.push(line);
          return;
        }
        const previous = parsed.at(-1);
        const next = lines.slice(index + 1).find(item => item.type !== 'action');
        const target = previous?.type === 'dialogue' ? previous : next?.type === 'dialogue' ? next : null;
        if (!target) {
          parsed.push(line);
          return;
        }
        const action = line.text;
        const voiceDirection = action.replace(/^(他|她|對方|对方|男人|女人|男孩|女孩)?[，,。；;：:\s]*/, '')
          .split(/[，,。；;]/).filter(part => /声音|声线|语气|语調|语调|低声|耳语|喊|吼|哭|笑|颤|顫|停顿|停頓|轻声|輕聲/.test(part)).join('，');
        target.direction = [target.direction, voiceDirection].filter(Boolean).join('，');
        if (!target.genderHint && /他/.test(action)) target.genderHint = 'male';
        if (!target.genderHint && /她/.test(action)) target.genderHint = 'female';
        target.stageDirection = [target.stageDirection, action].filter(Boolean).join('；');
      });
      if (!parsed.length) {
        showToast('先粘贴剧情文本或导入文件');
        return;
      }
      segments = parsed;
      roleVoices = {};
      renderAll();
      showToast(`已整理 ${segments.length} 段，可继续修正角色和台词`);
    }

    function renderRoles() {
      const names = [...new Set(segments.map(s => s.speaker).filter(Boolean))];
      document.getElementById('roleCount').textContent = names.length ? `${names.length} 个角色` : '等待解析';
      if (!names.length) {
        roleList.innerHTML = '<div class="empty-state"><strong>还没有角色</strong>解析文本后，为角色选择声音</div>';
        return;
      }
      roleList.innerHTML = names.map(name => {
        const voiceHtml = modelVoices.map(([id, label]) => `<option value="${id}">${label}</option>`).join('');
        return `<div class="role-row"><span class="role-name" title="${escapeHtml(name)}">${escapeHtml(name)}</span><select data-role="${escapeHtml(name)}" aria-label="${escapeHtml(name)} 的音色">${voiceHtml}</select></div>`;
      }).join('');
      roleList.querySelectorAll('select[data-role]').forEach(select => {
        const role = select.dataset.role;
        select.value = selectedModelVoice(role);
        select.addEventListener('change', () => { roleVoices[role] = select.value; });
      });
    }

    function renderSegments() {
      document.getElementById('segmentCount').textContent = `${segments.length} 段`;
      if (!segments.length) {
        segmentList.innerHTML = '<div class="empty-state"><strong>队列为空</strong>解析文本后，可以在播放前修正角色和内容</div>';
        return;
      }
      const names = [...new Set(['旁白', ...segments.map(s => s.speaker).filter(Boolean)])];
      segmentList.innerHTML = segments.map((segment, index) => {
        const typeLabel = {dialogue:'台词', narration:'旁白', action:'动作'}[segment.type] || '台词';
        const speakerOptions = names.map(n => `<option value="${escapeHtml(n)}" ${segment.speaker === n ? 'selected' : ''}>${escapeHtml(n)}</option>`).join('');
        const emotionHtml = emotionOptions.map(([key,label]) => `<option value="${key}" ${segment.emotion === key ? 'selected' : ''}>${label}</option>`).join('');
        return `<article class="segment" data-index="${index}">
          <span class="segment-index">${String(index + 1).padStart(2,'0')}</span>
          <div class="segment-fields">
            <div class="segment-tools">
              <span class="section-meta segment-type">${typeLabel}</span>
              <span class="role-name">${escapeHtml(segment.speaker || '旁白')}</span>
              ${segment.stageDirection ? `<span class="stage-note">（${escapeHtml(segment.stageDirection)}）</span>` : ''}
              ${segment.direction ? `<span class="section-meta">${escapeHtml(segment.direction)}</span>` : ''}
            </div>
            <textarea class="segment-text" data-field="text" aria-label="片段 ${index + 1} 文本">${escapeHtml(segment.text)}</textarea>
            <details class="segment-more">
              <summary>更多调整</summary>
              <div class="segment-advanced">
                <label>角色 <select data-field="speaker" aria-label="片段 ${index + 1} 的角色">${speakerOptions}</select></label>
                <label>语气 <select data-field="emotion" aria-label="片段 ${index + 1} 的语气">${emotionHtml}</select></label>
                <label class="check"><input data-field="skip" type="checkbox" ${segment.skip ? 'checked' : ''}>跳过这句</label>
                <textarea class="segment-direction" data-field="direction" aria-label="片段 ${index + 1} 的说话方式" placeholder="说话方式，例如：压低声音、带着哭腔">${escapeHtml(segment.direction || '')}</textarea>
              </div>
            </details>
          </div>
          <button class="button button-icon segment-remove" data-action="remove" type="button" title="删除片段" aria-label="删除片段 ${index + 1}">×</button>
        </article>`;
      }).join('');

      segmentList.querySelectorAll('.segment').forEach(row => {
        const i = Number(row.dataset.index);
        row.querySelector('[data-field="speaker"]').addEventListener('change', e => {
          segments[i].speaker = e.target.value;
          renderRoles();
        });
        row.querySelector('[data-field="emotion"]').addEventListener('change', e => { segments[i].emotion = e.target.value; });
        row.querySelector('[data-field="skip"]').addEventListener('change', e => { segments[i].skip = e.target.checked; });
        row.querySelector('[data-field="text"]').addEventListener('input', e => { segments[i].text = e.target.value; });
        row.querySelector('[data-field="direction"]').addEventListener('input', e => { segments[i].direction = e.target.value; });
        row.querySelector('[data-action="remove"]').addEventListener('click', () => {
          stopPlayback();
          segments.splice(i, 1);
          renderAll();
        });
      });
    }

    function renderAll() {
      renderRoles();
      renderSegments();
      document.getElementById('charCount').textContent = `${sourceText.value.length.toLocaleString()} 字`;
    }

    function allowedSegments() {
      return segments.map((s, i) => ({...s, index:i})).filter(s => {
        if (s.skip || !s.text.trim()) return false;
        if (s.type === 'narration' && !document.getElementById('includeNarration').checked) return false;
        if (s.type === 'action' && !document.getElementById('includeAction').checked) return false;
        return true;
      });
    }

    function setActive(index, label) {
      segmentList.querySelectorAll('.segment').forEach(row => row.classList.toggle('active', Number(row.dataset.index) === index));
      document.getElementById('playState').textContent = label;
      const item = segments[index];
      document.getElementById('subtitle').textContent = item ? `${item.speaker || '旁白'}：${item.text}` : '选择解析后的片段开始播放';
      if (item) segmentList.querySelector(`[data-index="${index}"]`)?.scrollIntoView({block:'nearest', behavior:'smooth'});
    }

    async function speakNext(id) {
      if (id !== runId) return;
      if (queueIndex >= queue.length) {
        document.getElementById('playState').textContent = '播放完成';
        queue = [];
        return;
      }
      const item = queue[queueIndex++];
      setActive(item.index, `正在播放 ${queueIndex} / ${queue.length}`);
      const controller = new AbortController();
      requestController = controller;
      try {
        const response = await fetch(`${ttsApiBase}/synthesize`, {
          method:'POST',
          headers:{'Content-Type':'application/json', Authorization:`Bearer ${authToken}`},
          body:JSON.stringify({
            text:item.text,
            speaker:selectedModelVoice(item.speaker || '旁白'),
            emotion:item.emotion,
            direction:item.direction || ''
          }),
          signal:controller.signal
        });
        if (response.status === 401 || response.status === 403) {
          showAuthGate('登录已失效，请重新登录。');
          return;
        }
        if (!response.ok) {
          const failure = await response.json().catch(() => ({}));
          throw new Error(failure.error || `TTS request failed (${response.status})`);
        }
        const audioBlob = await response.blob();
        if (id !== runId) return;
        currentAudioUrl = URL.createObjectURL(audioBlob);
        currentAudio = new Audio(currentAudioUrl);
        currentAudio.playbackRate = Number(document.getElementById('speedRange').value);
        currentAudio.onended = () => {
          URL.revokeObjectURL(currentAudioUrl);
          currentAudioUrl = null;
          currentAudio = null;
          speakNext(id);
        };
        currentAudio.onerror = () => {
          if (id !== runId) return;
          document.getElementById('playState').textContent = '语音播放失败';
          showToast('生成的音频无法播放');
        };
        await currentAudio.play();
      } catch (error) {
        if (id !== runId || error.name === 'AbortError') return;
        document.getElementById('playState').textContent = '语音播放失败';
        showToast(error.message || '服务器语音生成失败');
      } finally {
        if (requestController === controller) requestController = null;
      }
    }

    function startQueue(items) {
      if (!authToken) {
        showAuthGate('请先登录后再生成语音。');
        return;
      }
      if (!modelReady) {
        showToast('服务器模型尚未就绪');
        return;
      }
      if (!items.length) {
        showToast('没有可播放的片段');
        return;
      }
      stopAudioOutput();
      runId++;
      queue = items;
      queueIndex = 0;
      speakNext(runId);
    }

    function stopPlayback() {
      runId++;
      queue = [];
      queueIndex = 0;
      stopAudioOutput();
      segmentList.querySelectorAll('.segment.active').forEach(row => row.classList.remove('active'));
      document.getElementById('playState').textContent = '待播放';
      document.getElementById('subtitle').textContent = '选择解析后的片段开始播放';
    }

    function stopAudioOutput() {
      requestController?.abort();
      requestController = null;
      if (currentAudio) {
        currentAudio.pause();
        currentAudio.onended = null;
        currentAudio.onerror = null;
        currentAudio = null;
      }
      if (currentAudioUrl) URL.revokeObjectURL(currentAudioUrl);
      currentAudioUrl = null;
    }

    document.getElementById('authForm').addEventListener('submit', event => {
      event.preventDefault();
      authenticate('login');
    });
    document.getElementById('loginButton').addEventListener('click', () => authenticate('login'));
    document.getElementById('recoveryForm').addEventListener('submit', event => {
      event.preventDefault();
      requestPasswordReset();
    });
    document.getElementById('newPasswordForm').addEventListener('submit', event => {
      event.preventDefault();
      saveNewPassword();
    });
    document.getElementById('openRecoveryButton').addEventListener('click', () => {
      const loginEmail = document.getElementById('authEmail').value.trim();
      document.getElementById('recoveryEmail').value = loginEmail;
      setRecoveryMessage('');
      recoveryDialog.showModal();
      document.getElementById('recoveryEmail').focus();
    });
    for (const id of ['closeRecoveryButton', 'cancelRecoveryButton']) {
      document.getElementById(id).addEventListener('click', () => recoveryDialog.close());
    }
    document.getElementById('signupForm').addEventListener('submit', event => {
      event.preventDefault();
      authenticate('signup');
    });
    document.getElementById('openSignupButton').addEventListener('click', () => {
      setSignupMessage('');
      document.getElementById('resendSignupButton').hidden = true;
      signupDialog.showModal();
      document.getElementById('signupEmail').focus();
    });
    for (const id of ['closeSignupButton', 'cancelSignupButton']) {
      document.getElementById(id).addEventListener('click', () => signupDialog.close());
    }
    document.getElementById('toggleLoginPassword').addEventListener('click', () => togglePassword('authPassword', 'toggleLoginPassword'));
    document.getElementById('toggleSignupPassword').addEventListener('click', () => togglePassword('signupPassword', 'toggleSignupPassword'));
    document.getElementById('toggleConfirmPassword').addEventListener('click', () => togglePassword('signupPasswordConfirm', 'toggleConfirmPassword'));
    document.getElementById('resendSignupButton').addEventListener('click', async () => {
      const email = lastSignupEmail || document.getElementById('signupEmail').value.trim();
      if (!email) return;
      const button = document.getElementById('resendSignupButton');
      button.disabled = true;
      setSignupMessage('正在重新发送…');
      try {
        await supabaseRequest('resend', {type:'signup', email}, '', location.origin);
        setSignupMessage('如果该邮箱仍需验证，新的验证邮件已提交发送。');
      } catch (error) {
        setSignupMessage(error.message || '发送失败，请稍后重试。', true);
      } finally {
        button.disabled = false;
      }
    });
    document.getElementById('logoutButton').addEventListener('click', logout);
    document.getElementById('parseButton').addEventListener('click', parseScript);
    document.getElementById('copyPromptButton').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(deepSeekFormatPrompt);
        showToast('格式要求已复制，粘贴到 DeepSeek 对话中');
      } catch {
        const helper = document.createElement('textarea');
        helper.value = deepSeekFormatPrompt;
        helper.style.position = 'fixed';
        helper.style.opacity = '0';
        document.body.appendChild(helper);
        helper.select();
        const copied = document.execCommand('copy');
        helper.remove();
        showToast(copied ? '格式要求已复制，粘贴到 DeepSeek 对话中' : '复制失败，请检查浏览器剪贴板权限');
      }
    });
    document.getElementById('clearButton').addEventListener('click', () => {
      stopPlayback();
      sourceText.value = '';
      segments = [];
      roleVoices = {};
      renderAll();
    });
    sourceText.addEventListener('input', () => {
      document.getElementById('charCount').textContent = `${sourceText.value.length.toLocaleString()} 字`;
    });
    document.getElementById('fileInput').addEventListener('change', async event => {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      sourceText.value = await file.text();
      document.getElementById('charCount').textContent = `${sourceText.value.length.toLocaleString()} 字`;
      event.target.value = '';
      showToast(`已导入 ${file.name}`);
    });
    document.getElementById('playAll').addEventListener('click', () => startQueue(allowedSegments()));
    document.getElementById('stopButton').addEventListener('click', stopPlayback);
    document.getElementById('pauseButton').addEventListener('click', () => {
      if (!currentAudio) return;
      if (currentAudio.paused) {
        currentAudio.play();
        document.getElementById('playState').textContent = '继续播放';
      } else {
        currentAudio.pause();
        document.getElementById('playState').textContent = '已暂停';
      }
    });
    document.getElementById('speedRange').addEventListener('input', event => {
      document.getElementById('speedValue').textContent = `${Number(event.target.value).toFixed(2)}×`;
      if (currentAudio) currentAudio.playbackRate = Number(event.target.value);
    });
    segmentList.addEventListener('click', event => {
      const button = event.target.closest('[data-action="remove"]');
      if (!button) {
        const row = event.target.closest('.segment');
        if (event.target.closest('.button-icon') || !row) return;
        const item = segments[Number(row.dataset.index)];
        if (item && !item.skip) startQueue([{...item, index:Number(row.dataset.index)}]);
      }
    });
    const authPainting = document.getElementById('authPainting');
    const authArtTitle = document.getElementById('authArtTitle');
    const authArtCredit = document.getElementById('authArtCredit');
    const authArtSlides = [
      {
        image: 'assets/still-life-phlox.webp',
        fallback: 'assets/still-life-phlox.jpg',
        title: '让故事里的每一种情绪，都有自己的声音。',
        alt: 'Fanny Tiedjen-Bieber 的油画《静物与福禄考》：蓝色花瓶和多彩花朵',
        credit: '《静物与福禄考》· Fanny Tiedjen-Bieber · 公共领域',
        source: 'https://commons.wikimedia.org/wiki/File:Stillleben_mit_Flox_(Still_Life_with_Phlox).jpg',
        position: '52% 47%'
      },
      {
        image: 'assets/monet-flowers-fruit.webp',
        fallback: 'assets/monet-flowers-fruit.jpg',
        title: '把喜欢的剧情，变成听得见的陪伴。',
        alt: 'Claude Monet 的油画《鲜花与水果静物》',
        credit: '《鲜花与水果静物》· Claude Monet · CC0',
        source: 'https://commons.wikimedia.org/wiki/File:Still_Life_with_Flowers_and_Fruit_by_Claude_Monet,_1869,_Getty_Center.JPG',
        position: '50% 46%'
      }
    ];
    let authArtIndex = 0;
    window.setInterval(() => {
      if (document.hidden) return;
      const nextIndex = (authArtIndex + 1) % authArtSlides.length;
      const next = authArtSlides[nextIndex];
      const preload = new Image();
      const transitionTo = image => {
        authPainting.style.opacity = '0';
        authArtTitle.style.opacity = '0';
        window.setTimeout(() => {
          authPainting.style.backgroundImage = `url("${image}"),url("${next.fallback}")`;
          authPainting.style.backgroundPosition = next.position;
          authPainting.setAttribute('aria-label', next.alt);
          authArtTitle.textContent = next.title;
          authArtCredit.href = next.source;
          authArtCredit.textContent = next.credit;
          authPainting.style.opacity = '1';
          authArtTitle.style.opacity = '1';
          authArtIndex = nextIndex;
        }, 420);
      };
      preload.onload = () => transitionTo(next.image);
      preload.onerror = () => {
        const fallback = new Image();
        fallback.onload = () => transitionTo(next.fallback);
        fallback.src = next.fallback;
      };
      preload.src = next.image;
    }, 9000);
    initializeAuth();
    refreshModelStatus();
    setInterval(refreshModelStatus, 10000);
  </script>
</body>
</html>
