<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f7f6">
  <link rel="icon" href="/assets/favicon.ico?v=2" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/spiritwave-icon-32.png?v=2">
  <link rel="preload" as="image" href="/assets/still-life-phlox.webp" fetchpriority="high">
  <title>SpiritWave</title>
  <style>
    :root {
      color-scheme: light;
      --paper: #f5f7f6;
      --surface: #ffffff;
      --ink: #1d2928;
      --muted: #697775;
      --line: #dce4e1;
      --green: #147d70;
      --green-dark: #0e6259;
      --green-soft: #e4f2ef;
      --coral: #c65f48;
      --focus: #e9ac5b;
      --radius: 7px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: Inter, "Segoe UI", "Microsoft YaHei", sans-serif;
      font-size: 14px;
      line-height: 1.5;
    }
    button, textarea, select, input { font: inherit; }
    button, select, input[type="file"] { cursor: pointer; }
    button:focus-visible, select:focus-visible, textarea:focus-visible, input:focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }
    .shell { min-height: 100vh; padding-bottom: 108px; }
    .topbar {
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
    }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; }
    .brand-mark {
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      color: #fff;
      background: var(--green);
      border-radius: 6px;
      font-size: 16px;
    }
    .brand-name { font-size: 15px; }
    .status { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); }
    main { width: min(1180px, calc(100% - 48px)); margin: 28px auto 0; }
    .page-heading { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 20px; }
    h1 { margin: 0; font-size: 24px; line-height: 1.2; font-weight: 680; }
    .heading-actions { display: flex; gap: 8px; align-items: center; }
    .button {
      display: inline-flex;
      min-height: 36px;
      align-items: center;
      justify-content: center;
      gap: 7px;
      padding: 0 12px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: var(--ink);
      background: var(--surface);
      font-weight: 600;
      white-space: nowrap;
    }
    .button:hover { border-color: #a8bbb5; background: #fbfdfc; }
    .button-primary { color: #fff; border-color: var(--green); background: var(--green); }
    .button-primary:hover { color: #fff; border-color: var(--green-dark); background: var(--green-dark); }
    .button-quiet { color: var(--muted); background: transparent; }
    .button-icon { width: 36px; min-width: 36px; padding: 0; font-size: 16px; }
    .button:disabled { opacity: .45; cursor: not-allowed; }
    .layout { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr); gap: 22px; align-items: start; }
    .column { min-width: 0; }
    .section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    h2 { margin: 0; font-size: 15px; font-weight: 680; }
    .section-meta { color: var(--muted); font-size: 12px; }
    .input-area {
      display: block;
      width: 100%;
      min-height: 260px;
      resize: vertical;
      padding: 14px 15px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--ink);
      line-height: 1.7;
    }
    .input-area::placeholder { color: #99a5a2; }
    .source-help { display: grid; gap: 8px; margin: 0 0 10px; color: var(--muted); font-size: 12px; }
    .source-help summary { width: fit-content; cursor: pointer; }
    .source-prompt { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
    .source-prompt p { margin: 0; }
    .input-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 10px; }
    .input-hint { color: var(--muted); font-size: 12px; }
    .file-input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; clip-path: inset(50%); }
    .options-line { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); }
    .progressive-options summary, .segment-more summary, .speed-more summary { width: fit-content; color: var(--muted); cursor: pointer; font-size: 12px; }
    .progressive-options[open] .options-content { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; padding-top: 11px; }
    .check { display: inline-flex; align-items: center; gap: 7px; color: #42514e; font-size: 13px; }
    .check input { accent-color: var(--green); width: 15px; height: 15px; }
    .roles { margin-top: 24px; }
    .role-list { display: grid; gap: 8px; }
    .role-row { display: grid; grid-template-columns: minmax(100px, .7fr) minmax(0, 1.4fr); align-items: center; gap: 12px; min-height: 46px; padding: 7px 10px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
    .role-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
    select {
      min-width: 0;
      height: 34px;
      padding: 0 28px 0 9px;
      border: 1px solid var(--line);
      border-radius: 5px;
      background-color: #fff;
      color: var(--ink);
    }
    .voice-note { margin: 9px 0 0; color: var(--muted); font-size: 12px; }
    .segments { display: grid; gap: 0; border-top: 1px solid var(--line); }
    .segment {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr) 36px;
      gap: 10px;
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
      transition: background-color .15s ease;
    }
    .segment.active { background: var(--green-soft); }
    .segment-index { padding-top: 7px; color: #899693; text-align: right; font-size: 11px; }
    .segment-fields { min-width: 0; display: grid; gap: 7px; }
    .segment-tools { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
    .segment-tools select { height: 30px; font-size: 12px; }
    .segment-type { color: #4e605c; }
    .stage-note { color: var(--muted); font-size: 12px; }
    .emotion { max-width: 105px; }
    .skip-check { margin-left: auto; }
    .segment-more { display: grid; gap: 10px; padding: 3px 0 0; }
    .segment-more[open] summary { margin-bottom: 2px; }
    .segment-advanced { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
    .segment-direction { width: 100%; min-height: 38px; resize: vertical; padding: 7px 9px; border: 1px solid var(--line); border-radius: 5px; }
    .segment-text {
      width: 100%;
      min-height: 45px;
      resize: vertical;
      padding: 8px 10px;
      border: 1px solid transparent;
      border-radius: 5px;
      background: rgba(255,255,255,.72);
      color: var(--ink);
      line-height: 1.55;
    }
    .segment-text:focus { border-color: #a5c9c0; background: #fff; outline: none; }
    .segment-remove { align-self: start; margin-top: 2px; color: #87928f; border-color: transparent; background: transparent; }
    .segment-remove:hover { color: var(--coral); border-color: #efd6d0; background: #fff9f7; }
    .empty-state { padding: 30px 14px; color: var(--muted); text-align: center; border: 1px dashed #cbd6d2; border-radius: var(--radius); }
    .empty-state strong { display: block; margin-bottom: 4px; color: #465652; font-weight: 600; }
    .player {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 5;
      padding: 12px 24px 14px;
      background: rgba(255,255,255,.97);
      border-top: 1px solid var(--line);
      backdrop-filter: blur(12px);
    }
    .player-inner { width: min(1180px, 100%); margin: 0 auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; }
    .now-playing { min-width: 0; }
    .now-label { color: var(--muted); font-size: 11px; }
    .subtitle { overflow: hidden; margin-top: 2px; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
    .transport { display: flex; align-items: center; gap: 8px; }
    .speed-control { justify-self: end; display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 12px; }
    .speed-control input { width: 100px; accent-color: var(--green); }
    .speed-more { position: relative; justify-self: end; color: var(--muted); font-size: 12px; }
    .speed-more .speed-control { position: absolute; right: 0; bottom: 25px; padding: 10px; background: #fff; border: 1px solid var(--line); border-radius: 6px; }
    .privacy-note { margin-top: 9px; color: #86918e; text-align: center; font-size: 11px; }
    .auth-gate { position: fixed; inset: 0; z-index: 20; display: grid; grid-template-columns:minmax(300px, .92fr) minmax(360px, 1.08fr); padding:0; overflow-y:auto; background:#f7f4ef; }
    .auth-brand { position:relative; isolation:isolate; display:flex; flex-direction:column; justify-content:space-between; min-height:100%; padding:38px; overflow:hidden; color:#fffdf5; background:#445b56; }
    .auth-brand-spacer { height:1px; }
    .auth-painting { position:absolute; z-index:-2; inset:-2%; background-image:url("assets/still-life-phlox.webp"),url("assets/still-life-phlox.jpg"); background-position:52% 47%; background-size:cover; animation:auth-paint-drift 32s ease-in-out infinite alternate; transition:opacity .42s ease; }
    .auth-brand::after { position:absolute; z-index:-1; inset:0; content:""; background:linear-gradient(180deg,rgba(24,33,31,.3),rgba(24,33,31,.04) 23%,rgba(24,33,31,.08) 42%,rgba(24,33,31,.42) 66%,rgba(24,33,31,.76)); }
    .auth-brand-top { display:flex; align-items:center; }
    .auth-brand-name { font-family:Georgia,"Times New Roman",serif; font-size:30px; font-weight:600; }
    .auth-art-caption { position:absolute; right:38px; bottom:110px; left:38px; max-width:480px; margin:0; transition:opacity .35s ease; }
    .auth-art-kicker { margin:0 0 10px; color:#f2d6ab; font-size:11px; font-weight:700; text-shadow:0 1px 8px rgba(0,0,0,.65); }
    .auth-art-title { margin:0; font-family:Georgia,"Noto Serif SC",serif; font-size:clamp(26px,3vw,40px); font-weight:500; line-height:1.3; text-shadow:0 2px 12px rgba(0,0,0,.78),0 1px 2px rgba(0,0,0,.9); }
    .auth-art-credit { margin:12px 0 0; color:rgba(255,253,245,.9); font-size:11px; text-shadow:0 1px 7px rgba(0,0,0,.8); }
    .auth-art-credit a { color:inherit; text-underline-offset:3px; }
    .auth-wave { display:flex; align-items:center; gap:5px; height:54px; }
    .auth-wave span { width:4px; height:var(--bar-height); border-radius:4px; background:var(--bar-color); transform-origin:center; animation:auth-wave 1.25s ease-in-out var(--delay) infinite alternate; }
    .auth-stage { position:relative; display:grid; place-items:center; min-width:0; padding:32px; overflow:hidden; background:#f7f4ef; }
    .auth-stage-brand { position:absolute; z-index:1; top:30px; left:32px; display:flex; align-items:center; gap:9px; }
    .auth-stage-brand img { display:block; width:36px; height:34px; object-fit:contain; flex:0 0 auto; }
    .auth-stage-brand .auth-brand-name { color:#194d48; }
    .auth-stage::before,.auth-stage::after { position:absolute; z-index:0; width:34px; height:140px; border-radius:52% 18% 42% 12%/22% 48% 16% 54%; content:""; opacity:.2; transform:rotate(22deg); animation:auth-pigment 7.5s ease-in-out infinite alternate; }
    .auth-stage::before { top:5%; right:8%; background:#c26049; }
    .auth-stage::after { bottom:4%; left:6%; width:22px; height:88px; background:#bd873d; animation-delay:-4s; }
    .auth-panel { width: min(400px, 100%); padding:0; border:0; background:transparent; }
    .auth-title { margin: 0 0 20px; font-size: 25px; }
    .auth-subtitle { margin:-12px 0 21px; color:var(--muted); font-size:16px; font-weight:600; }
    .auth-fields { display: grid; gap: 12px; }
    .auth-field { display: grid; gap: 5px; color: var(--muted); font-size: 12px; }
    .auth-field input { width: 100%; height: 44px; padding: 0 12px; border: 1px solid #cfdad6; border-radius: 6px; color: var(--ink); background: var(--surface); }
    .auth-field input:focus { border-color:var(--green); outline:2px solid rgba(20,125,112,.16); }
    .password-control { position: relative; }
    .password-control input { padding-right: 46px; }
    .visibility-toggle { position: absolute; top: 2px; right: 3px; width: 36px; min-height: 36px; display: grid; place-items: center; padding: 0; border: 0; color: var(--muted); background: transparent; }
    .visibility-toggle:hover { color: var(--ink); }
    .visibility-toggle svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .auth-actions { display: grid; margin-top: 18px; }
    .auth-options { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:12px; font-size:12px; }
    .remember-option { display:inline-flex; align-items:center; gap:7px; min-height:24px; color:var(--muted); cursor:pointer; }
    .remember-option input { width:15px; height:15px; margin:0; accent-color:var(--green); }
    .auth-switch { margin: 13px 0 0; color: var(--muted); text-align: center; font-size: 12px; }
    .text-button { padding: 0; border: 0; color: var(--green-dark); background: transparent; font-weight: 700; }
    .text-button:hover { text-decoration: underline; }
    .signup-dialog { width: min(440px,calc(100% - 28px)); max-width:none; max-height:calc(100% - 28px); padding:0; overflow:auto; border:1px solid var(--line); border-radius:7px; color:var(--ink); background:var(--surface); }
    .signup-dialog::backdrop { background:rgba(22,34,31,.45); }
    .signup-panel { padding:24px; }
    .signup-head { display:flex; align-items:start; justify-content:space-between; gap:12px; margin-bottom:18px; }
    .signup-head h2 { margin:0; font-size:20px; }
    .signup-copy { margin:5px 0 0; color:var(--muted); font-size:12px; }
    .signup-actions { display:grid; grid-template-columns:1fr auto; gap:8px; margin-top:16px; }
    .auth-message { min-height: 20px; margin: 12px 0 0; color: var(--muted); font-size: 12px; }
    .auth-message[data-error="true"] { color: var(--coral); }
    .account-controls { display: flex; align-items: center; gap: 10px; }
    .account-email { max-width: 220px; overflow: hidden; color: var(--muted); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
    .account-role { color: var(--green-dark); font-size: 11px; font-weight: 700; white-space: nowrap; }
    [hidden] { display: none !important; }
    .toast { position: fixed; right: 18px; bottom: 116px; z-index: 10; max-width: min(360px, calc(100vw - 36px)); padding: 10px 13px; border-radius: 6px; color: #fff; background: #263b37; opacity: 0; transform: translateY(8px); pointer-events: none; transition: .18s ease; }
    .toast.show { opacity: 1; transform: translateY(0); }
    @media (max-width: 820px) {
      main { width: min(100% - 32px, 640px); margin-top: 20px; }
      .topbar { padding: 0 16px; }
      .layout { grid-template-columns: 1fr; gap: 26px; }
      .input-area { min-height: 190px; }
      .roles { margin-top: 18px; }
      .player { padding: 10px 16px 12px; }
      .player-inner { grid-template-columns: 1fr auto; gap: 7px 12px; }
      .now-playing { grid-column: 1 / -1; }
      .speed-control { grid-column: 2; grid-row: 2; }
      .transport { grid-column: 1; grid-row: 2; }
      .speed-control input { width: 74px; }
      .privacy-note { display: none; }
      .shell { padding-bottom: 120px; }
    }
    @media (max-width: 480px) {
      .page-heading { align-items: start; flex-direction: column; }
      .heading-actions { width: 100%; }
      .heading-actions .button { flex: 1; }
      .status-text { max-width: 135px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .account-email { max-width: 112px; }
      .input-footer { align-items: start; flex-direction: column; }
      .input-footer .button { width: 100%; }
      .role-row { grid-template-columns: minmax(78px, .65fr) minmax(0, 1.35fr); gap: 8px; padding: 7px; }
      .segment { grid-template-columns: 23px minmax(0,1fr) 32px; gap: 7px; }
      .segment-tools { gap: 5px; }
      .segment-tools select { max-width: 48%; }
      .skip-check { margin-left: 0; }
      .button-icon { width: 32px; min-width: 32px; min-height: 32px; }
      .player-inner { gap: 7px; }
      .transport { gap: 5px; }
      .speed-control { gap: 5px; }
    }
    @keyframes auth-wave { from { transform:scaleY(.45); opacity:.74; } to { transform:scaleY(1); opacity:1; } }
    @keyframes auth-paint-drift { from { transform:scale(1.02) translate3d(0,0,0); } to { transform:scale(1.09) translate3d(-1.1%,.7%,0); } }
    @keyframes auth-pigment { from { translate:0 -2px; scale:.94 1; } to { translate:0 18px; scale:1.1 1; } }
    @media (max-width: 720px) {
      .auth-gate { position:absolute; min-height:100vh; min-height:100dvh; grid-template-columns:1fr; grid-template-rows:210px minmax(390px,1fr); }
      .auth-brand { min-height:210px; padding:20px 24px 16px; }
      .auth-brand-top { align-self:start; }
      .auth-brand-name { font-size:26px; }
      .auth-art-caption { right:88px; bottom:60px; left:24px; max-width:none; transform:none; }
      .auth-art-kicker,.auth-art-credit { display:none; }
      .auth-art-title { font-size:22px; }
      .auth-wave { position:absolute; right:24px; bottom:20px; height:34px; gap:4px; }
      .auth-wave span { width:3px; }
      .auth-stage { place-items:start center; padding:78px 24px max(40px,env(safe-area-inset-bottom)); }
      .auth-stage-brand { top:22px; left:24px; }
      .auth-panel { margin:auto 0; }
      .signup-dialog { width:calc(100% - 20px); max-height:calc(100dvh - 20px); }
      .signup-panel { padding:20px; }
    }
    @media (max-width: 380px) {
      .auth-gate { grid-template-rows:190px minmax(390px,1fr); }
      .auth-brand { min-height:190px; padding:17px 19px 14px; }
      .auth-brand-name { font-size:24px; }
      .auth-art-caption { max-width:calc(100% - 64px); }
      .auth-art-title { font-size:20px; }
      .auth-wave { right:18px; bottom:17px; }
      .auth-stage { padding-right:20px; padding-left:20px; }
      .signup-panel { padding:17px; }
      .signup-actions { grid-template-columns:1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .auth-painting,.auth-wave span,.auth-stage::before,.auth-stage::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; }
    }
  </style>
</head>
<body>
  <section class="auth-gate" id="authGate" aria-labelledby="authTitle">
    <div class="auth-brand" aria-label="SpiritWave">
      <div class="auth-painting" id="authPainting" role="img" aria-label="Fanny Tiedjen-Bieber 的油画《静物与福禄考》：蓝色花瓶和多彩花朵"></div>
      <div class="auth-brand-spacer" aria-hidden="true"></div>
      <div class="auth-art-caption"><p class="auth-art-kicker">STORIES, IN COLOR AND SOUND</p><h2 class="auth-art-title" id="authArtTitle">让故事里的每一种情绪，都有自己的声音。</h2><p class="auth-art-credit"><a id="authArtCredit" href="https://commons.wikimedia.org/wiki/File:Stillleben_mit_Flox_(Still_Life_with_Phlox).jpg" target="_blank" rel="noreferrer">《静物与福禄考》· Fanny Tiedjen-Bieber · 公共领域</a></p></div>
      <div class="auth-wave" aria-hidden="true">
        <span style="--bar-height:18px;--bar-color:#e8aa68;--delay:-.2s"></span><span style="--bar-height:32px;--bar-color:#d77862;--delay:-.7s"></span><span style="--bar-height:45px;--bar-color:#72b7a8;--delay:-.4s"></span><span style="--bar-height:25px;--bar-color:#e8aa68;--delay:-1s"></span><span style="--bar-height:38px;--bar-color:#d77862;--delay:-.1s"></span><span style="--bar-height:16px;--bar-color:#72b7a8;--delay:-.8s"></span><span style="--bar-height:30px;--bar-color:#e8aa68;--delay:-.5s"></span><span style="--bar-height:48px;--bar-color:#72b7a8;--delay:-.3s"></span><span style="--bar-height:24px;--bar-color:#d77862;--delay:-.9s"></span><span style="--bar-height:36px;--bar-color:#e8aa68;--delay:-.6s"></span><span style="--bar-height:17px;--bar-color:#72b7a8;--delay:-.15s"></span><span style="--bar-height:29px;--bar-color:#d77862;--delay:-.55s"></span>
      </div>
    </div>
    <div class="auth-stage">
      <div class="auth-stage-brand"><img src="/assets/spiritwave-mark.png" alt="" aria-hidden="true" width="36" height="34"><span class="auth-brand-name">SpiritWave</span></div>
      <form class="auth-panel" id="authForm">
        <h1 class="auth-title" id="authTitle">登录</h1>
        <p class="auth-subtitle">继续你的故事，欢迎回来！</p>
        <div class="auth-fields">
          <label class="auth-field" for="authEmail">邮箱<input id="authEmail" type="email" autocomplete="email" required></label>
          <label class="auth-field" for="authPassword">密码
            <span class="password-control"><input id="authPassword" type="password" autocomplete="current-password" required>
              <button class="visibility-toggle" id="toggleLoginPassword" type="button" aria-label="显示密码" title="显示密码">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </button>
            </span>
          </label>
